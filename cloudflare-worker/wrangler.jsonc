{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ur-msg-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ur-msg",
      "database_id": "893145ea-f43a-40f7-af57-fb5bef62eee6"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "30 23 * * *"]
  },
  "vars": {
    "GITHUB_OWNER": "ethancod1ng",
    "GITHUB_REPO": "ur-msg",
    "GITHUB_WORKFLOW": "monitor.yml",
    "GITHUB_DAILY_WORKFLOW": "daily-digest.yml",
    "GITHUB_REF": "main"
  }
}
